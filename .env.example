# --- Grunnleggende --------------------------------------------------------
NODE_ENV=production
PORT=8080
# Må være https i produksjon. Brukes i lenker i e-post og som Stripe-retur-URL.
BASE_URL=https://registervakt.no

BRAND_NAME=Registervakt
SUPPORT_EMAIL=hei@registervakt.no
ORG_NAME=Ditt Firma AS
ORG_NUMBER=

# --- Lagring --------------------------------------------------------------
# På Fly peker denne inn i det monterte volumet.
DATABASE_PATH=/data/registervakt.db
BACKUP_DIR=/data/backups

# --- Stripe ---------------------------------------------------------------
# Test: sk_test_... / whsec_... — bytt til live-nøkler ved lansering.
STRIPE_SECRET_KEY=sk_test_bytt_meg
STRIPE_WEBHOOK_SECRET=whsec_bytt_meg
STRIPE_PRICE_SOLO=price_bytt_meg
STRIPE_PRICE_BYRAA=price_bytt_meg
STRIPE_TRIAL_DAYS=14

# --- E-post (Resend) ------------------------------------------------------
MAIL_PROVIDER=resend
RESEND_API_KEY=re_bytt_meg
# Avsenderdomenet må være verifisert i Resend.
MAIL_FROM=Registervakt <varsel@registervakt.no>
MAIL_REPLY_TO=hei@registervakt.no

# --- Drift ----------------------------------------------------------------
# Hit går feilvarsler, ukentlig sikkerhetskopi og helsevarsler.
ALERT_EMAIL=din@epost.no
ALERT_COOLDOWN_MINUTES=120
STALE_POLL_HOURS=6
# Lang, tilfeldig streng. Gir tilgang til /admin/*.
ADMIN_TOKEN=bytt_meg_til_noe_langt_og_tilfeldig

# --- Oppførsel ------------------------------------------------------------
POLL_INTERVAL_MINUTES=60
DIGEST_HOUR_OSLO=7
LOG_LEVEL=info
